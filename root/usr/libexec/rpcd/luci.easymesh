#!/usr/bin/env lua
-- rpcd backend for MTK EasyMesh (MAP / wapp / bs20) on mtwifi-cfg.
-- Configuration is written natively (no shell/sed string concatenation),
-- user supplied arguments are strictly validated before reaching wappctrl.

local json = require "luci.jsonc"
local fs   = require "nixio.fs"
local sys  = require "luci.sys"
local uci  = require "luci.model.uci"

local MAPD_CFG  = "/etc/map/mapd_cfg"
local MAP1905   = "/etc/map/1905d.cfg"

-- locate a MTK daemon tool that firmwares may install under different bin
-- dirs (237 / closed-source builds are known to move these around). Probing
-- the common paths keeps every panel action working out of the box instead
-- of failing on a single hard-coded /sbin path.
local function find_tool(basename)
	for _, dir in ipairs({ "/sbin", "/usr/sbin", "/usr/bin", "/bin" }) do
		local p = dir .. "/" .. basename
		if fs.access(p) then return p end
	end
	return nil
end

-- The MTK wapp control binary is named "wappctl" on device, but the panel
-- (and some SDK revisions) has historically used "wappctrl". Probe both,
-- preferring the real "wappctl", so the tool is always found.
local function find_wappctl()
	for _, name in ipairs({ "wappctl", "wappctrl" }) do
		local p = find_tool(name)
		if p then return p end
	end
	return nil
end

-- daemon names: the mtwifi-wapp package (237 / hanwckf / ZJJCKA builds)
-- ships "wapp" and "bs20" in /sbin; the closed-source MTK SDK EasyMesh set
-- ships the same "wapp" plus "p1905_managerd" (1905daemon package) and
-- "mapd" (mapd package) under /usr/bin, managed by the procd init scripts
-- /etc/init.d/wapp and /etc/init.d/easymesh. every kill / probe walks the
-- alias lists so the panel keeps working on every layout.
local WAPP_NAMES = { "wapp", "wappd" }
local BS20_NAMES = { "bs20", "1905daemon", "p1905_managerd" }
local MAPD_NAMES = { "mapd" }
-- procd services of the SDK layout, stopped/started via /etc/init.d/<svc>
local SDK_INITS = { "easymesh", "wapp" }

-- last startup failure reason, surfaced to the frontend through getStatus
-- so the panel can show why wapp did not come up instead of a generic error
local STATE_ERROR = "/tmp/luci-easymesh.start_error"

local function set_start_error(msg)
	if msg and msg ~= "" then
		fs.writefile(STATE_ERROR, msg)
	else
		os.remove(STATE_ERROR)
	end
end

-- backup file format version written into the backup header
local BACKUP_VERSION = 1

local function readfile(path)
	local s = fs.readfile(path)
	return s and (s:gsub("^%s+", ""):gsub("%s+$", ""))
end

local function exec(cmd)
	local h = io.popen(cmd .. " 2>/dev/null")
	local out = h and h:read("*a") or ""
	if h then h:close() end
	return out or ""
end

local function run(cmd)
	return sys.call(cmd .. " >/dev/null 2>&1")
end

-- ---------------------------------------------------------------------------
-- key = value file handling (mapd_cfg / 1905d.cfg), plain prefix matching so
-- keys like "dpp-uri" work without any pattern escaping.
-- ---------------------------------------------------------------------------

local function kv_clean(v)
	v = tostring(v or "")
	v = v:gsub("[%z\1-\31\127]", "")
	return v:gsub("^%s+", ""):gsub("%s+$", "")
end

local function kv_get(path, key)
	local data = fs.readfile(path)
	if not data then return nil end
	local prefix = key .. "="
	local val
	for line in data:gmatch("[^\r\n]+") do
		if line:sub(1, #prefix) == prefix then
			val = kv_clean(line:sub(#prefix + 1))
		end
	end
	if val ~= nil and val ~= "" then return val end
	return (val == "") and "" or nil
end

local function kv_set(path, updates)
	local data = fs.readfile(path)
	if data == nil then return false end

	local pending = {}
	for k in pairs(updates) do pending[k] = true end

	local out = {}
	for line in (data .. "\n"):gmatch("(.-)\r?\n") do
		local replaced = false
		for k, v in pairs(updates) do
			local prefix = k .. "="
			if line:sub(1, #prefix) == prefix then
				table.insert(out, k .. "=" .. kv_clean(v))
				replaced = true
				pending[k] = nil
				break
			end
		end
		if not replaced then table.insert(out, line) end
	end

	-- append keys that were not present in the file yet
	for k in pairs(pending) do
		table.insert(out, k .. "=" .. kv_clean(updates[k]))
	end

	local content = table.concat(out, "\n") .. "\n"

	-- write via temporary file so a partial write never corrupts the config
	local tmp = path .. ".luci.tmp"
	if fs.writefile(tmp, content) then
		return os.rename(tmp, path) and true or false
	end
	return false
end

local function kv_set_1(path, key, value)
	return kv_set(path, { [key] = value })
end

-- ---------------------------------------------------------------------------
-- helpers
-- ---------------------------------------------------------------------------

local function br_mac()
	local m = readfile("/sys/class/net/br-lan/address")
	return m and m:lower() or ""
end

-- true if a daemon (wapp/bs20) is running; exact comm match first, then a
-- /proc cmdline fallback for firmware that wraps the daemon and changes the
-- process comm. The name is anchored on both sides ("/" or line start
-- before, space or line end after) so "wapp" can never false-positive on
-- "wappctrl" / "startwapp.sh" / "wappd", and "bs20" never matches an
-- unrelated longer name.
local function cmdline_has_name(c, name)
	local i = 1
	while true do
		local s, e = c:find(name, i, true)
		if not s then return false end
		local before = (s > 1) and c:sub(s - 1, s - 1) or ""
		local after = c:sub(e + 1, e + 1)
		if (before == "" or before == "/") and (after == "" or after == " ") then
			return true
		end
		i = s + 1
	end
end

local function proc_running(name)
	local out = exec("pgrep -x '" .. name .. "'")
	if out:gsub("%s+", "") ~= "" then return true end
	local proc = io.popen("/bin/ls /proc 2>/dev/null")
	if not proc then return false end
	for pid in proc:lines() do
		if pid:match("^%d+$") then
			local f = io.open("/proc/" .. pid .. "/cmdline", "rb")
			if f then
				local c = f:read("*a"):gsub("%z", " ")
				f:close()
				if cmdline_has_name(c, name) then
					proc:close()
					return true
				end
			end
		end
	end
	proc:close()
	return false
end

local function any_running(names)
	for _, n in ipairs(names) do
		if proc_running(n) then return true end
	end
	return false
end

local function mtwifi_radios()
	local cursor = uci.cursor()
	local radios = {}
	cursor:foreach("wireless", "wifi-device", function(s)
		if s.type == "mtwifi" then
			table.insert(radios, {
				name = s[".name"],
				band = s.band or "",
				channel = s.channel or "",
				disabled = s.disabled or "0",
				dbdc_main = s.dbdc_main or "0"
			})
		end
	end)
	return radios
end

local function ifname_for_radio(name, band)
	local cursor = uci.cursor()
	local idx = cursor:get("wireless", name, "ifidx") or "0"
	if band == "5g" or band == "5G" or band == "6g" or name:match("_2$") then
		return "rax" .. idx
	end
	return "ra" .. idx
end

local function parse_stainfo(text)
	local stas = {}
	for line in text:gmatch("[^\r\n]+") do
		local mac = line:match("(%x%x:%x%x:%x%x:%x%x:%x%x:%x%x)")
		if mac then
			local rssi = line:match("(-%d+)")
			table.insert(stas, { mac = mac:upper(), rssi = rssi or "" })
		end
	end
	return stas
end

-- DeviceRole: 0 = auto, 1 = controller, 2 = agent (mapd_cfg)
local function role_map(role)
	if role == "controller" then return "1" end
	if role == "agent" then return "2" end
	return "0"
end

local function current_role()
	local dr = kv_get(MAPD_CFG, "DeviceRole")
	if dr == "1" then return "controller" end
	if dr == "2" then return "agent" end
	-- fall back to the 1905d map_root flag
	local root = kv_get(MAP1905, "map_root")
	if root == "1" then return "controller" end
	if root == "0" then return "agent" end
	return "auto"
end

local function current_mode()
	local m = kv_get(MAPD_CFG, "mode")
	if m == "1" then return "router" end
	if m == "2" then return "bridge" end
	return "unknown"
end

