local function schema_updates(cursor)
	local updates, per_file = {}, {}
	for _, e in ipairs(MAP_SCHEMA) do
		local v = cursor:get("easymesh", "config", e.u)
		if v == nil then v = e.d end
		per_file[e.f] = per_file[e.f] or {}
		per_file[e.f][e.k] = kv_clean(v)
	end
	for file, upd in pairs(per_file) do
		updates[file] = upd
	end
	return updates
end

-- ---------------------------------------------------------------------------
-- page-scoped reset groups
--
-- The Basic Settings page owns the master switch, device mode / role, the
-- radio feature flags (mesh_sr / bandsteering / steeringthresold), the
-- backhaul type and backhaul profile 0. Everything else in MAP_SCHEMA is
-- shown on the Advanced Settings page.
-- ---------------------------------------------------------------------------

local BASIC_DEFAULTS = {
	enabled          = "0",
	device_mode      = "router",
	device_role      = "controller",
	mesh_sr          = "1",
	bandsteering     = "1",
	steeringthresold = "-65",
}

local function basic_owned(u)
	if BASIC_DEFAULTS[u] ~= nil then return true end
	if u == "bh_type" then return true end
	return u:match("^bh0_") ~= nil
end

-- reset uci options and their mapd_cfg / 1905d.cfg keys for a given scope
-- ("basic", "advanced" or "all"); wireless is never touched here
local function reset_options(cursor, scope)
	local per_file = {}

	if scope ~= "advanced" then
		for u, d in pairs(BASIC_DEFAULTS) do
			cursor:set("easymesh", "config", u, d)
		end
		kv_set_1(MAPD_CFG, "DeviceRole", role_map(BASIC_DEFAULTS.device_role))
		kv_set_1(MAPD_CFG, "mode", "1")
		kv_set(MAP1905, { map_root = "1", map_agent = "1" })
	end

	for _, e in ipairs(MAP_SCHEMA) do
		local owned
		if scope == "basic" then
			owned = basic_owned(e.u)
		elseif scope == "advanced" then
			owned = not basic_owned(e.u)
		else
			owned = true
		end
		if owned then
			cursor:set("easymesh", "config", e.u, e.d)
			per_file[e.f] = per_file[e.f] or {}
			per_file[e.f][e.k] = e.d
		end
	end

	if scope == "all" then
		local al = br_mac()
		if al ~= "" then
			per_file[MAP1905] = per_file[MAP1905] or {}
			per_file[MAP1905]["map_controller_alid"] = al
			per_file[MAP1905]["map_agent_alid"] = al
		end
	end

	for file, upd in pairs(per_file) do
		kv_set(file, upd)
	end
end

-- ---------------------------------------------------------------------------
-- wireless (mtwifi) UCI sync + daemon restart
-- ---------------------------------------------------------------------------

local function sync_wireless(cursor, enabled, bandsteering, mesh_sr, steeringthresold)
	cursor:foreach("wireless", "wifi-device", function(s)
		if s.type == "mtwifi" then
			cursor:set("wireless", s[".name"], "wapp", enabled)
			if enabled == "1" then
				cursor:set("wireless", s[".name"], "bandsteering", bandsteering)
				cursor:set("wireless", s[".name"], "ieee80211r", mesh_sr)
			else
				-- the platform hotplug (100-startwapp) restarts wapp whenever
				-- bandsteering / ieee80211r is set, so zero them to keep
				-- EasyMesh disabled across hotplug events
				cursor:set("wireless", s[".name"], "bandsteering", "0")
				cursor:set("wireless", s[".name"], "ieee80211r", "0")
			end
		end
	end)
	cursor:foreach("wireless", "wifi-iface", function(s)
		if s.mode == "ap" or s.mode == nil then
			cursor:set("wireless", s[".name"], "steeringthresold", steeringthresold)
		end
	end)
	cursor:commit("wireless")
end

-- ---------------------------------------------------------------------------
-- daemon control. stop every known alias, then bring EasyMesh back up
-- using whatever this firmware provides:
--   1. the closed-source MTK SDK EasyMesh set (wapp / 1905daemon / mapd
--      packages): procd init scripts /etc/init.d/wapp and
--      /etc/init.d/easymesh run the whole bring-up sequence (driver
--      setup, uci2map, daemon launch) - always preferred over a
--      hand-rolled start on that layout;
--   2. the firmware startwapp.sh (mtwifi-wapp) - only when the hard-coded
--      MT798x radio section names it decides from actually exist on this
--      device, otherwise it silently declines and wapp stays down;
--   3. a direct "wapp -d1 -v2 -c<ifaces>" + bs20 start derived from the
--      live mtwifi radios, which works on every section naming / firmware
--      combination and therefore never silently fails.
-- ---------------------------------------------------------------------------

-- startwapp.sh of the mtwifi-wapp package decides which radios wapp runs
-- on from hard-coded wifi-device section names (MT7981_1_1 / MT7986_1_1).
-- It is only trustworthy on devices whose radios are actually named that
-- way; anywhere else it exits with "no interface requires wapp start".
local STARTWAPP_SECTIONS = { "MT7981_1_1", "MT7986_1_1" }

local function startwapp_sections_present()
	local cursor = uci.cursor()
	for _, name in ipairs(STARTWAPP_SECTIONS) do
		if cursor:get("wireless", name, "type") == "mtwifi" then
			return true
		end
	end
	return false
end

-- daemons must survive the rpcd call that started them
local function run_bg(cmd)
	sys.call(cmd .. " >/dev/null 2>&1 &")
end

local function stop_daemons()
	-- SDK layout services are procd-managed: stop them through their init
	-- scripts first so procd does not respawn the daemons behind our back
	for _, svc in ipairs(SDK_INITS) do
		if fs.access("/etc/init.d/" .. svc) then
			run("/etc/init.d/" .. svc .. " stop")
		end
	end
	for _, name in ipairs(MAPD_NAMES) do run("killall " .. name) end
	for _, name in ipairs(WAPP_NAMES) do run("killall " .. name) end
	for _, name in ipairs(BS20_NAMES) do run("killall " .. name) end
end

-- main AP interface of every enabled mtwifi radio, e.g. { "ra0", "rax0" }
-- (sorted so the generated wapp command line is deterministic)
local function wapp_ifaces()
	local ifaces = {}
	for _, r in ipairs(mtwifi_radios()) do
		if r.disabled ~= "1" then
			local ifn = ifname_for_radio(r.name, r.band)
			local dup = false
			for _, v in ipairs(ifaces) do
				if v == ifn then
					dup = true
					break
				end
			end
			if not dup then table.insert(ifaces, ifn) end
		end
	end
	table.sort(ifaces)
	return ifaces
end

-- mirror the essential steps of startwapp.sh but derive the interfaces
-- from the live mtwifi radios instead of hardcoded MT798x section names,
-- so EasyMesh comes up on every device / firmware combination
local function start_daemons_direct()
	local wapp = find_tool("wapp")
	if not wapp then
		return false, "the wapp daemon binary was not found (mtwifi-wapp is not installed?)"
	end

	local ifaces = wapp_ifaces()
	if #ifaces == 0 then
		return false, "no enabled mtwifi radio found"
	end

	-- the 1905 ALIDs must match the br-lan MAC before the daemons come up
	local al = br_mac()
	if al ~= "" then
		kv_set(MAP1905, { map_controller_alid = al, map_agent_alid = al })
	end

	local args = {}
	for _, ifn in ipairs(ifaces) do
		table.insert(args, "-c" .. ifn)
	end
	run_bg(string.format("%s -d1 -v2 %s", wapp, table.concat(args, " ")))
	os.execute("sleep 1")

	-- driver level MAP setup, mirroring startwapp.sh
	for _, ifn in ipairs(ifaces) do
		run("iwpriv " .. ifn .. " set mapR2Enable=0")
		run("iwpriv " .. ifn .. " set mapTSEnable=0")
		run("iwpriv " .. ifn .. " set mapR3Enable=0")
		run("iwpriv " .. ifn .. " set DppEnable=0")
		run("iwpriv " .. ifn .. " set mapEnable=2")
	end

	local bs20 = find_tool("bs20") or find_tool("1905daemon")
	if bs20 then run_bg(bs20) end

	-- reset the wapp MBO state like startwapp.sh does (best effort)
	local ctl = find_wappctl()
	if ctl then
		for _, ifn in ipairs(ifaces) do
			run(string.format("%s %s mbo reset_default", ctl, ifn))
		end
	end

	if any_running(WAPP_NAMES) then return true, "direct start" end
	return false, "wapp did not stay up after the direct start"
end

-- SDK layout startup: use the firmware's own procd init scripts. The wapp
-- init script declines to start unless uci wapp.wapp.enable=1, so make
-- sure that flag follows the panel switch before restarting.
local function start_daemons_sdk()
	local inits = {}
	for _, svc in ipairs({ "wapp", "easymesh" }) do
		if fs.access("/etc/init.d/" .. svc) then table.insert(inits, svc) end
	end
	if #inits == 0 then
		return false, "no SDK init scripts (wapp/easymesh)"
	end

	if fs.access("/etc/config/wapp") then
		local c = uci.cursor()
		if c:get("wapp", "wapp", "enable") ~= "1" then
			c:set("wapp", "wapp", "enable", "1")
			c:commit("wapp")
		end
	end

	for _, svc in ipairs(inits) do
		run("/etc/init.d/" .. svc .. " restart")
	end
	os.execute("sleep 2")

	if any_running(WAPP_NAMES) then
		return true, "SDK init (" .. table.concat(inits, "+") .. ")"
	end
	return false, "SDK init (" .. table.concat(inits, "+") .. ") ran but wapp did not come up"
end

local function restart_daemons(enabled)
	stop_daemons()
	if enabled ~= "1" then
		-- keep the SDK wapp service from coming back on the next boot
		if fs.access("/etc/config/wapp") then
			local c = uci.cursor()
			if c:get("wapp", "wapp", "enable") ~= "0" then
				c:set("wapp", "wapp", "enable", "0")
				c:commit("wapp")
			end
		end
		set_start_error(nil)
		return true, "stopped"
	end

	-- 1. SDK layout: the firmware's own procd init scripts run the whole
	--    bring-up sequence and are the canonical entry point there
	local ok_sdk, via_sdk = start_daemons_sdk()
	if ok_sdk then
		set_start_error(nil)
		return true, via_sdk
	end

	-- 2. firmware startwapp.sh: performs the full official bring-up
	--    (ALID rewrite, driver iwpriv MAP setup, bs20, MBO reset), but it
	--    decides the wapp interfaces from hard-coded MT798x section names,
	--    so only run it when those sections exist on this device
	if startwapp_sections_present() then
		local sh = find_tool("startwapp.sh")
		if sh then
			run(sh)
			if any_running(WAPP_NAMES) then
				set_start_error(nil)
				return true, "startwapp.sh"
			end
			via_sdk = via_sdk .. "; startwapp.sh ran but did not bring wapp up"
		end
	end

	-- 3. direct start derived from the live mtwifi radios: the fallback
	--    that works on every device regardless of section naming
	local ok_direct, via_direct = start_daemons_direct()
	if ok_direct then
		set_start_error(nil)
		return true, via_direct
	end

	-- nothing worked: remember why so the panel can show the real reason
	set_start_error(via_sdk .. "; " .. via_direct)
	return false, via_sdk .. "; " .. via_direct
end

-- ---------------------------------------------------------------------------
-- argument validation helpers (all user input passes through these before
-- it is ever placed into a shell command line)
-- ---------------------------------------------------------------------------

local function v_iface(name)
	name = (name ~= nil and name ~= "") and tostring(name) or "ra0"
	if not name:match("^[raix][raix]?[0-9]+$") then return nil end
	return name
end

-- wireless backhaul client interfaces look like "apcli0" / "apclix0"
local function v_apcli(name)
	name = (name ~= nil and name ~= "") and tostring(name) or "apcli0"
	if not name:match("^apclix?%d+$") then return nil end
	return name
end

local function v_mac(mac)
	mac = tostring(mac or ""):lower()
	if not mac:match("^%x%x:%x%x:%x%x:%x%x:%x%x:%x%x$") then return nil end
	return mac
end

local function v_uint(s)
	s = tostring(s or "")
	if not s:match("^[0-9]+$") then return nil end
	return s
end

-- bootstrap / configurator / pkex id: either "*" (all) or a number
local function v_id(s)
	s = tostring(s or "")
	if s == "*" or s:match("^[0-9]+$") then return s end
	return nil
end

-- normalize the argument table so omitted optional parameters read as ""
-- instead of nil (LuCI rpc.declare omits undefined params)
local function norm(args)
	return setmetatable(args or {}, { __index = function() return "" end })
end

-- allow printable ASCII except quote / backslash / backtick / dollar so the
-- value can be embedded into a single quoted shell argument safely
local function v_text(s)
	s = tostring(s or "")
	if s == "" then return nil end
	if s:find("[%z\1-\31\127\"'\\`$]") then return nil end
	return s
end

local function wappctrl(iface, args)
	local bin = find_wappctl()
	if not bin then return "" end
	return exec(string.format("%s %s %s", bin, iface, args))
end

-- ---------------------------------------------------------------------------
-- host name / IP lookup for connected stations (idea from the legacy
-- luci-app-mtk sta_info controller, which enriched every station with the
-- DHCP / ARP hints known to the system)
-- ---------------------------------------------------------------------------

local function host_hints()
	local ok, hints = pcall(function() return sys.net.host_hints() end)
	if not ok or type(hints) ~= "table" then return {} end
	return hints
end

local function collect_stas()
	local all, seen = {}, {}
	local hints = host_hints()
	for _, r in ipairs(mtwifi_radios()) do
		if r.disabled ~= "1" then
			local ifn = ifname_for_radio(r.name, r.band)
			local stas = parse_stainfo(exec("iwpriv " .. ifn .. " show stainfo"))
			for _, s in ipairs(stas) do
				if not seen[s.mac] then
					seen[s.mac] = true
					s.radio = r.name
					s.ifname = ifn
					s.band = r.band
					local h = hints[s.mac] or hints[s.mac:lower()]
					if h then
						s.hostname = h.name or ""
						s.ip = h.ipv4 or h.ipv6 or ""
					end
					table.insert(all, s)
				end
			end
		end
	end
	return all
end

-- ---------------------------------------------------------------------------
-- backhaul link handling (ported from the legacy luci-app-mtk apcli_scan /
-- get_apcli_conn_info controllers, reimplemented on top of iwpriv without
-- the compiled ioctl helper)
-- ---------------------------------------------------------------------------

-- trigger a site survey and parse the iwpriv get_site_survey table; the
-- column offsets are taken from the header line, SSIDs with blanks included
local function site_survey(iface)
	if not v_iface(iface) then return nil, "Invalid interface name" end
	if not fs.access("/sys/class/net/" .. iface) then
		return nil, "Interface " .. iface .. " does not exist"
	end
	run("iwpriv " .. iface .. " set SiteSurvey=0")
	-- the survey needs a few seconds to complete before the table is read
	os.execute("sleep 4")
	local out = exec("iwpriv " .. iface .. " get_site_survey")

	local cols, results = nil, {}
	for line in out:gmatch("[^\r\n]+") do
		local has_mac = line:match("%s+%x%x:%x%x:%x%x:%x%x:%x%x:%x%x%s+")
		if #line > 40 and not has_mac then
			-- header line: remember the column start of every field
			local c = {}
			local function col(pat)
				local s, e = line:find(pat)
				if s then c[#c + 1] = { s, e - s } end
			end
			col("Ch ")
			col("SSID")
			col("BSSID")
			col("Security")
			col("Sig%a%al")
			col("W%-Mode")
			col("ExtCH")
			col("WPS")
			if #c >= 5 then cols = c end
		elseif cols and has_mac then
			local entry = {}
			-- channel, ssid, bssid, security, signal, mode, extch, wps in the
			-- same order as the header columns found above
			local order = { "channel", "ssid", "bssid", "security", "rssi", "mode", "extch", "wps" }
			for i, def in ipairs(cols) do
				local name = order[i] or ("col" .. i)
				entry[name] = line:sub(def[1], def[1] + def[2]):gsub("^%s+", ""):gsub("%s+$", "")
			end
			if entry.bssid ~= "" and #entry.bssid >= 17 then
				entry.bssid = entry.bssid:sub(1, 17):upper()
				entry.rssi = entry.rssi or ""
				table.insert(results, entry)
			end
		end
	end

	table.sort(results, function(a, b)
		return (tonumber(a.rssi) or -999) > (tonumber(b.rssi) or -999)
	end)
	return results
end

-- current state of the wireless backhaul client interfaces (apcli*), the
-- equivalent of the legacy get_apcli_conn_info page data
local function backhaul_status()
	local candidates = {}
	for _, r in ipairs(mtwifi_radios()) do
		local idx = uci.cursor():get("wireless", r.name, "ifidx") or "0"
		if r.band == "5g" or r.band == "5G" or r.band == "6g" or r.name:match("_2$") then
			candidates["apclix" .. idx] = r.name
		else
			candidates["apcli" .. idx] = r.name
		end
	end

	local out = {}
	for ifn, radio in pairs(candidates) do
		local entry = { ifname = ifn, radio = radio, state = "down", ssid = "", bssid = "" }
		local flags = readfile("/sys/class/net/" .. ifn .. "/flags")
		local n = flags and tonumber(flags:gsub("%s+", ""), 16)
		if n then
			entry.state = (n % 2 == 1) and "up" or "down"
			local iw = exec("iwconfig " .. ifn .. " 2>/dev/null")
			entry.ssid = iw:match("ESSID:\"(.*)\"") or ""
			entry.bssid = (iw:match("Access Point:%s*(%x%x:%x%x:%x%x:%x%x:%x%x:%x%x)") or ""):upper()
			local sig = iw:match("Signal level[=:]%s*(%-?%d+)")
			entry.rssi = sig or ""
			if entry.ssid ~= "" then
				entry.conn_state = "Connected"
			else
				entry.conn_state = "Disconnected"
				entry.state = "down"
			end
		end
		table.insert(out, entry)
	end

	table.sort(out, function(a, b) return a.ifname < b.ifname end)
	return out
end

-- ---------------------------------------------------------------------------
-- rpc methods
-- ---------------------------------------------------------------------------

-- push the committed easymesh UCI options into mapd_cfg / 1905d.cfg
-- and return the values needed for the wireless sync
local function push_config(cursor)
	local enabled = cursor:get("easymesh", "config", "enabled") or "0"
	local role = cursor:get("easymesh", "config", "device_role") or "auto"
	local mode = cursor:get("easymesh", "config", "device_mode") or "router"
	local mesh_sr = cursor:get("easymesh", "config", "mesh_sr") or "1"
	local bandsteering = cursor:get("easymesh", "config", "bandsteering") or "1"
	local steeringthresold = cursor:get("easymesh", "config", "steeringthresold") or "-65"

	-- mapd_cfg: DeviceRole 0 = auto, 1 = controller, 2 = agent;
	-- mode is the device mode: 1 = router, 2 = bridge
	kv_set_1(MAPD_CFG, "DeviceRole", role_map(role))
	kv_set_1(MAPD_CFG, "mode", (mode == "bridge") and "2" or "1")

	for file, upd in pairs(schema_updates(cursor)) do
		kv_set(file, upd)
	end

	-- 1905d.cfg role / ALID handling
	local upd1905 = {}
	upd1905["map_agent"] = "1"
	if role == "controller" then
		upd1905["map_root"] = "1"
	elseif role == "agent" then
		upd1905["map_root"] = "0"
	end
	local al = br_mac()
	local ctrl_alid = kv_clean(cursor:get("easymesh", "config", "ctrl_alid") or "")
	local agent_alid = kv_clean(cursor:get("easymesh", "config", "agent_alid") or "")
	if ctrl_alid ~= "" then
		upd1905["map_controller_alid"] = ctrl_alid
	elseif al ~= "" then
		upd1905["map_controller_alid"] = al
	end
	if agent_alid ~= "" then
		upd1905["map_agent_alid"] = agent_alid
	elseif al ~= "" then
		upd1905["map_agent_alid"] = al
	end
	kv_set(MAP1905, upd1905)

	return enabled, bandsteering, mesh_sr, steeringthresold
end

local methods = {
	getConfig = {
		call = function()
			local cursor = uci.cursor()
			local cfg = {}

			cfg.enabled = cursor:get("easymesh", "config", "enabled") or "0"
			cfg.device_mode = cursor:get("easymesh", "config", "device_mode") or "router"
			cfg.device_role = cursor:get("easymesh", "config", "device_role") or "auto"
			cfg.mesh_sr = cursor:get("easymesh", "config", "mesh_sr") or "1"
			cfg.bandsteering = cursor:get("easymesh", "config", "bandsteering") or "1"
			cfg.steeringthresold = cursor:get("easymesh", "config", "steeringthresold") or "-65"

			-- live values as currently present in the config files,
			-- used by the frontend to detect unapplied changes
			--
			-- ctrl_alid / agent_alid are excluded from the drift check: they are
			-- expert ALID overrides whose empty default auto-resolves to the
			-- br-lan MAC (written into 1905d.cfg on apply). Comparing empty
			-- against the resolved MAC would permanently flag a spurious drift,
			-- so they never enter cfg.live.
			cfg.live = {}
			for _, e in ipairs(MAP_SCHEMA) do
				if e.u ~= "ctrl_alid" and e.u ~= "agent_alid" then
					if cfg[e.u] == nil then
						cfg[e.u] = cursor:get("easymesh", "config", e.u) or e.d
					end
					cfg.live[e.u] = kv_get(e.f, e.k)
					if cfg.live[e.u] == nil then cfg.live[e.u] = e.d end
				end
			end
			-- still expose the effective ALIDs (resolved / override) for display
			cfg.ctrl_alid = cursor:get("easymesh", "config", "ctrl_alid")
				or kv_get(MAP1905, "map_controller_alid") or ""
			cfg.agent_alid = cursor:get("easymesh", "config", "agent_alid")
				or kv_get(MAP1905, "map_agent_alid") or ""

			cfg.cur_mode = current_mode()
			cfg.cur_role = current_role()
			cfg.cur_steer_enable = kv_get(MAPD_CFG, "SteerEnable") or ""
			cfg.startwapp_available = find_tool("startwapp.sh") ~= nil
			cfg.wappctrl_available = find_wappctl() ~= nil
			cfg.wapp_available = (find_tool("wapp") or find_tool("wappd")) ~= nil
			cfg.bs20_available = (find_tool("bs20") or find_tool("1905daemon") or find_tool("p1905_managerd")) ~= nil
			cfg.sdk_init_available = (fs.access("/etc/init.d/wapp") or fs.access("/etc/init.d/easymesh")) and true or false
			cfg.map_cfg_available = (fs.access(MAPD_CFG) and fs.access(MAP1905)) and true or false
			print(json.stringify(cfg))
		end
	},

	getStatus = {
		call = function()
			local status = {
				wapp_running = any_running(WAPP_NAMES),
				bs20_running = any_running(BS20_NAMES),
				last_error = readfile(STATE_ERROR) or "",
				al_mac = br_mac(),
				map_ver = kv_get(MAP1905, "map_ver") or "",
				device_role = current_role(),
				device_mode = current_mode(),
				controller_alid = kv_get(MAP1905, "map_controller_alid") or "",
				agent_alid = kv_get(MAP1905, "map_agent_alid") or "",
				steer_enable = kv_get(MAPD_CFG, "SteerEnable") or "",
				radios = mtwifi_radios()
			}
			print(json.stringify(status))
		end
	},

	getTopology = {
		call = function()
			local topo = {
				al_mac = br_mac(),
				map_ver = kv_get(MAP1905, "map_ver") or "",
				device_role = current_role(),
				device_mode = current_mode(),
				controller_alid = kv_get(MAP1905, "map_controller_alid") or "",
				agent_alid = kv_get(MAP1905, "map_agent_alid") or "",
				wapp_running = any_running(WAPP_NAMES),
				radios = mtwifi_radios(),
				stations = collect_stas(),
				backhaul = backhaul_status()
			}
			print(json.stringify(topo))
		end
	},

	-- current state of the wireless backhaul (apcli) client links
	bhStatus = {
		call = function()
			print(json.stringify({ ok = true, backhaul = backhaul_status() }))
		end
	},

	-- trigger a site survey and return the surrounding networks so the
	-- backhaul SSID can be picked from a list instead of typed by hand
	bhScan = {
		args = { iface = "" },
		call = function(_args)
			local args = norm(_args)
			local iface = v_iface(args.iface)
			if not iface then
				print(json.stringify({ ok = false, error = "Invalid interface name" }))
				return
			end
			local results, err = site_survey(iface)
			if not results then
				print(json.stringify({ ok = false, error = err }))
				return
			end
			print(json.stringify({ ok = true, iface = iface, results = results }))
		end
	},

	-- bring the wireless backhaul client up with the given (or already saved)
	-- backhaul profile 0 credentials; ported from the legacy apcli_connect
	-- controller, reimplemented with validated iwpriv calls
	bhConnect = {
		args = { iface = "", ssid = "", auth = "", enc = "", key = "" },
		call = function(_args)
			local args = norm(_args)
			local iface = v_apcli(args.iface)
			if not iface then
				print(json.stringify({ ok = false, error = "Invalid interface name" }))
				return
			end

			-- credentials: use the arguments when given, otherwise fall back
			-- to the committed backhaul profile 0 in easymesh UCI; every value
			-- ends up in a shell command line, so all of them pass v_text
			local cursor = uci.cursor()
			local function cred(argval, opt)
				local v = (argval ~= "") and argval
					or (cursor:get("easymesh", "config", opt) or "")
				if v == "" then return "" end -- empty enc/key is valid (OPEN)
				return v_text(v)
			end

			local ssid = cred(args.ssid, "bh0_ssid")
			local enc  = cred(args.enc, "bh0_enc")
			local key  = cred(args.key, "bh0_key")

			-- auth modes understood by the mtwifi apcli driver
			local auth_modes = {
				OPEN = true, WPAPSK = true, WPA2PSK = true, WPA3PSK = true,
				WPAPSKWPA2PSK = true, WPA2PSKWPA3PSK = true
			}
			local auth = (args.auth ~= "") and args.auth
				or (cursor:get("easymesh", "config", "bh0_auth") or "")
			if auth == "" then auth = "WPA2PSK" end
			if not auth_modes[auth] then
				print(json.stringify({ ok = false, error = "Invalid authentication mode" }))
				return
			end

			if not ssid or #ssid == 0 then
				print(json.stringify({ ok = false,
					error = "No backhaul SSID: save the Backhaul Profile 0 settings first" }))
				return
			end
			if not enc or not key then
				print(json.stringify({ ok = false, error = "Invalid credentials" }))
				return
			end

			-- normalize the encryption default
			if auth ~= "OPEN" and enc == "" then enc = "AES" end

			-- persist the profile so mapd / 1905d know the credentials too
			cursor:set("easymesh", "config", "bh0_valid", "1")
			cursor:set("easymesh", "config", "bh0_ssid", ssid)
			cursor:set("easymesh", "config", "bh0_auth", auth)
			cursor:set("easymesh", "config", "bh0_enc", (auth == "OPEN") and "" or enc)
			cursor:set("easymesh", "config", "bh0_key", (auth == "OPEN") and "" or key)
			cursor:set("easymesh", "config", "bh_type", "wifi")
			cursor:commit("easymesh")
			kv_set(MAPD_CFG, {
				BhProfile0Valid = "1",
				BhProfile0Ssid = ssid,
				BhProfile0AuthMode = auth,
				BhProfile0EncrypType = (auth == "OPEN") and "" or enc,
				BhProfile0WpaPsk = (auth == "OPEN") and "" or key
			})
			kv_set_1(MAP1905, "bh_type", "wifi")

			-- apply to the driver; every value passed v_text / the whitelist
			-- above, so the single quoted shell words are safe
			run("ifconfig " .. iface .. " up")
			run("iwpriv " .. iface .. " set ApCliEnable=0")
			run("iwpriv " .. iface .. " set ApCliAuthMode=" .. auth)
			if auth ~= "OPEN" then
				run("iwpriv " .. iface .. " set ApCliEncrypType='" .. enc .. "'")
				run("iwpriv " .. iface .. " set ApCliWPAPSK='" .. key .. "'")
			end
			run("iwpriv " .. iface .. " set ApCliSsid='" .. ssid .. "'")
			run("iwpriv " .. iface .. " set ApCliEnable=1")
			run("iwpriv " .. iface .. " set ApCliAutoConnect=3")

			print(json.stringify({
				ok = true,
				iface = iface,
				ssid = ssid,
				auth = auth,
				persisted = true
			}))
		end
	},

	-- tear the wireless backhaul client down; ported from the legacy
	-- apcli_disconnect controller
	bhDisconnect = {
		args = { iface = "" },
		call = function(_args)
			local args = norm(_args)
			local iface = v_apcli(args.iface)
			if not iface then
				print(json.stringify({ ok = false, error = "Invalid interface name" }))
				return
			end
			run("iwpriv " .. iface .. " set ApCliEnable=0")
			run("ifconfig " .. iface .. " down")
			print(json.stringify({ ok = true, iface = iface }))
		end
	},

	applyConfig = {
		call = function()
			local cursor = uci.cursor()
			local enabled, bandsteering, mesh_sr, steeringthresold = push_config(cursor)

			sync_wireless(cursor, enabled, bandsteering, mesh_sr, steeringthresold)
			local started, via = restart_daemons(enabled)

			print(json.stringify({
				ok = true,
				enabled = enabled,
				restarted = (enabled == "1") and started or false,
				started_via = (enabled == "1") and via or nil
			}))
		end
	},

	-- reset only the options shown on one page ("basic" or "advanced");
	-- wireless is intentionally left untouched by a page reset
	resetPage = {
		args = { scope = "" },
		call = function(_args)
			local args = norm(_args)
			local scope = tostring(args.scope or "")
			if scope ~= "basic" and scope ~= "advanced" then
				print(json.stringify({ ok = false, error = "Invalid scope" }))
				return
			end
			local cursor = uci.cursor()
			reset_options(cursor, scope)
			cursor:commit("easymesh")
			local enabled = cursor:get("easymesh", "config", "enabled") or "0"
			restart_daemons(enabled)
			print(json.stringify({ ok = true, scope = scope, enabled = enabled }))
		end
	},

	-- reset every easymesh option and mapd / 1905 key to defaults and stop
	-- the daemons, but leave wireless exactly as it is
	resetAll = {
		call = function()
			local cursor = uci.cursor()
			reset_options(cursor, "all")
			cursor:commit("easymesh")
			restart_daemons("0")
			print(json.stringify({ ok = true }))
		end
	},

	backupConfig = {
		call = function()
			local content = fs.readfile("/etc/config/easymesh")
			if not content then
				print(json.stringify({ ok = false, error = "Cannot read /etc/config/easymesh" }))
				return
			end
			-- header comment lines are stripped again on restore
			local header = string.format(
				"# luci-app-mtk-easymesh backup v%d\n# generated: %s\n",
				BACKUP_VERSION, os.date("%Y-%m-%d %H:%M:%S"))
			print(json.stringify({ ok = true, content = header .. content }))
		end
	},

	-- one-shot diagnostics bundle: everything a human (or an AI) needs to
	-- debug "cannot start / not detected" reports, as plain text with clear
	-- section markers. secrets (wifi keys, backhaul passphrases) are masked.
	collectDiagnostics = {
		call = function()
			local out = {}
			local function sec(title)
				out[#out + 1] = ""
				out[#out + 1] = "=============================================================="
				out[#out + 1] = "== " .. title
				out[#out + 1] = "=============================================================="
			end
			local function kv(k, v)
				out[#out + 1] = string.format("%-34s: %s", tostring(k), tostring(v))
			end
			local function raw(s)
				out[#out + 1] = (s:gsub("%s+$", ""))
			end

			sec("DEVICE / FIRMWARE")
			kv("generated", os.date("%Y-%m-%d %H:%M:%S"))
			raw(exec("ubus call system board 2>/dev/null") or "")
			kv("uptime", exec("uptime 2>/dev/null"):gsub("%s+$", ""))

			sec("PLUGIN STATE (uci: easymesh)")
			local cursor = uci.cursor()
			local function dump_uci(cfg, stypes, mask_keys)
				cursor:foreach(cfg, stypes, function(s)
					raw(string.format("config %s '%s'", s[".type"], s[".name"]))
					local keys = {}
					for k in pairs(s) do
						if k:sub(1, 1) ~= "." then table.insert(keys, k) end
					end
					table.sort(keys)
					for _, k in ipairs(keys) do
						local v = s[k]
						if type(v) == "table" then
							local parts = {}
							for _, item in ipairs(v) do table.insert(parts, tostring(item)) end
							v = table.concat(parts, ", ")
						else
							v = tostring(v)
						end
						if mask_keys and (k:match("key%d*$") or k == "key" or k == "psk" or k == "password") and #v > 0 then
							v = "****MASKED****"
						end
						raw(string.format("\toption %s '%s'", k, v))
					end
				end)
			end
			dump_uci("easymesh", "easymesh", false)

			sec("TOOL / DAEMON BINARY PROBES")
			local probes = {
				{ "wapp (daemon)", "wapp" },
				{ "wappd (daemon alias)", "wappd" },
				{ "bs20 (daemon)", "bs20" },
				{ "1905daemon (alias)", "1905daemon" },
				{ "p1905_managerd (SDK 1905daemon pkg)", "p1905_managerd" },
				{ "1905ctrl (SDK)", "1905ctrl" },
				{ "mapd (SDK MAP controller)", "mapd" },
				{ "mapd_cli (SDK)", "mapd_cli" },
				{ "wappctl", "wappctl" },
				{ "wappctrl", "wappctrl" },
				{ "startwapp.sh", "startwapp.sh" },
				{ "wapp_openwrt.sh (SDK)", "wapp_openwrt.sh" },
				{ "EasyMesh_openwrt.sh (SDK)", "EasyMesh_openwrt.sh" },
				{ "mtwifi_cfg", "mtwifi_cfg" },
				{ "iwpriv", "iwpriv" },
				{ "pgrep", "pgrep" },
				{ "logread", "logread" }
			}
			for _, p in ipairs(probes) do
				local found
				for _, dir in ipairs({ "/sbin", "/usr/sbin", "/usr/bin", "/bin" }) do
					if fs.access(dir .. "/" .. p[2]) then
						found = (found and (found .. " ") or "") .. dir .. "/" .. p[2]
					end
				end
				kv(p[1], found or "NOT FOUND")
			end
			kv("/etc/map/mapd_cfg", fs.access(MAPD_CFG) and "present" or "MISSING")
			kv("/etc/map/1905d.cfg", fs.access(MAP1905) and "present" or "MISSING")
			kv("/etc/config/easymesh", fs.access("/etc/config/easymesh") and "present" or "MISSING")
			kv("/etc/init.d/wapp (SDK)", fs.access("/etc/init.d/wapp") and "present" or "MISSING")
			kv("/etc/init.d/easymesh (SDK)", fs.access("/etc/init.d/easymesh") and "present" or "MISSING")
			kv("/etc/config/wapp (SDK, gates init.d/wapp)", fs.access("/etc/config/wapp") and "present" or "MISSING")

			sec("DAEMON RUNTIME STATUS")
			kv("wapp running (wapp|wappd)", tostring(any_running(WAPP_NAMES)))
			kv("bs20 running (bs20|1905daemon|p1905_managerd)", tostring(any_running(BS20_NAMES)))
			kv("mapd running (SDK controller)", tostring(any_running(MAPD_NAMES)))
			raw("pgrep -a output:")
			raw(exec("pgrep -a -f 'wapp|bs20|1905|mapd' 2>/dev/null") or "")
			if (exec("pgrep -a -f 'wapp|bs20|1905|mapd' 2>/dev/null") or ""):gsub("%s+", "") == "" then
				raw("(no matching process)")
			end
			raw("ps output:")
			raw(exec("ps w 2>/dev/null | grep -E 'wapp|bs20|1905|mapd' | grep -v grep") or "")
			if (exec("ps w 2>/dev/null | grep -E 'wapp|bs20|1905|mapd' | grep -v grep") or ""):gsub("%s+", "") == "" then
				raw("(no matching process)")
			end

			sec("WIRELESS CONFIG (uci: wireless, secrets masked)")
			dump_uci("wireless", "wifi-device", true)
			dump_uci("wireless", "wifi-iface", true)

			sec("MAP CONFIG FILES (secrets masked)")
			raw("-- /etc/map/mapd_cfg --")
			local mapd = fs.readfile(MAPD_CFG)
			if mapd then
				for line in mapd:gmatch("[^\r\n]+") do
					local k, v = line:match("^([%w_]-)=(.*)$")
					if v and v ~= "" and k and (k:find("Psk") or k:find("Key") or k:find("Password")) then
						raw(k .. "=****MASKED****")
					else
						raw(line)
					end
				end
			else
				raw("(file missing)")
			end
			raw("-- /etc/map/1905d.cfg --")
			local m1905 = fs.readfile(MAP1905)
			if m1905 then
				for line in m1905:gmatch("[^\r\n]+") do
					local k, v = line:match("^([%w_]-)=(.*)$")
					if v and v ~= "" and k and (k:find("Psk") or k:find("Key") or k:find("Password")) then
						raw(k .. "=****MASKED****")
					else
						raw(line)
					end
				end
			else
				raw("(file missing)")
			end

			sec("WAPP VERSION / CONTROL TOOL")
			local ctl = find_wappctl()
			kv("control tool", ctl or "NOT FOUND")
			if ctl then
				raw(exec(ctl .. " ra0 version 2>&1 | head -n 20") or "")
			end

			sec("NETWORK INTERFACES")
			raw(exec("ls /sys/class/net 2>/dev/null") or "")

			sec("SYSTEM LOG (wapp / bs20 / 1905 / mapd / easymesh, last 120 lines)")
			local logs = exec("logread 2>/dev/null | grep -iE 'wapp|bs20|1905|mapd|easymesh|startwapp' | tail -n 120")
			raw(logs ~= "" and logs or "(no matching log lines)")

			out[#out + 1] = ""
			out[#out + 1] = "=== END OF DIAGNOSTICS ==="

			print(json.stringify({
				ok = true,
				filename = "easymesh-diagnostics-" .. os.date("%Y%m%d-%H%M%S") .. ".txt",
				content = table.concat(out, "\n")
			}))
		end
	},

	restoreConfig = {
		args = { content = "" },
		call = function(_args)
			local args = norm(_args)
			local content = tostring(args.content or "")
			if #content == 0 or #content > 65536 then
				print(json.stringify({ ok = false, error = "Invalid backup content" }))
				return
			end
			if content:find("[%z\1-\8\11\12\14-\31]") then
				print(json.stringify({ ok = false, error = "Backup contains control characters" }))
				return
			end

			-- strip comment lines (backup header), remember its version
			local version, lines = nil, {}
			for line in content:gmatch("[^\r\n]+") do
				local v = line:match("^%s*#%s*luci%-app%-mtk%-easymesh backup v([0-9]+)")
				if v then version = tonumber(v) end
				if not line:match("^%s*#") then
					table.insert(lines, line)
				end
			end
			content = table.concat(lines, "\n") .. "\n"

			if version and version > BACKUP_VERSION then
				print(json.stringify({
					ok = false,
					error = "Backup was created by a newer plugin version, please update luci-app-mtk-easymesh first."
				}))
				return
			end

			if not content:match("config%s+easymesh") then
				print(json.stringify({ ok = false, error = "Not an easymesh UCI backup file" }))
				return
			end

			local tmp = "/etc/config/easymesh.luci.tmp"
			if not fs.writefile(tmp, content) or not os.rename(tmp, "/etc/config/easymesh") then
				print(json.stringify({ ok = false, error = "Failed to write /etc/config/easymesh" }))
				return
			end

			local cursor = uci.cursor()
			local enabled, bandsteering, mesh_sr, steeringthresold = push_config(cursor)
			sync_wireless(cursor, enabled, bandsteering, mesh_sr, steeringthresold)
			local started, via = restart_daemons(enabled)

			print(json.stringify({
				ok = true,
				enabled = enabled,
				restarted = (enabled == "1") and started or false,
				started_via = (enabled == "1") and via or nil,
				legacy = (version == nil) or nil
			}))
		end
	},

	-- one-shot apply used by the setup wizard: only the basic page options
	-- are accepted, every value is strictly validated
	wizardApply = {
		args = {
			enabled = "", device_mode = "", device_role = "",
			mesh_sr = "", bandsteering = "", steeringthresold = "",
			bh_type = "", bh0_ssid = "", bh0_auth = "",
			bh0_enc = "", bh0_key = "", bh0_raid = ""
		},
		call = function(_args)
			local args = norm(_args)

			local function flag(v)
				if v == "" then return nil end
				if v == "0" or v == "1" then return v end
				return false
			end

			local vals = {}
			local function take(name, v, ok)
				if v == "" or v == nil then return true end
				if ok == nil or ok == false then
					print(json.stringify({ ok = false, error = "Invalid value for " .. name }))
					return false
				end
				vals[name] = ok
				return true
			end

			if not take("enabled", args.enabled, flag(args.enabled)) then return end
			if not take("mesh_sr", args.mesh_sr, flag(args.mesh_sr)) then return end
			if not take("bandsteering", args.bandsteering, flag(args.bandsteering)) then return end

			if args.device_mode ~= "" then
				if args.device_mode ~= "router" and args.device_mode ~= "bridge" then
					print(json.stringify({ ok = false, error = "Invalid value for device_mode" }))
					return
				end
				vals.device_mode = args.device_mode
			end
			if args.device_role ~= "" then
				if args.device_role ~= "auto" and args.device_role ~= "controller" and args.device_role ~= "agent" then
					print(json.stringify({ ok = false, error = "Invalid value for device_role" }))
					return
				end
				vals.device_role = args.device_role
			end
			if args.steeringthresold ~= "" then
				local n = args.steeringthresold:match("^-?%d+$")
				if not n then
					print(json.stringify({ ok = false, error = "Invalid value for steeringthresold" }))
					return
				end
				vals.steeringthresold = n
			end
			if args.bh_type ~= "" then
				if args.bh_type ~= "eth" and args.bh_type ~= "wifi" then
					print(json.stringify({ ok = false, error = "Invalid value for bh_type" }))
					return
				end
				vals.bh_type = args.bh_type
			end

			-- backhaul profile 0 credentials: printable text only
			for _, opt in ipairs({ "bh0_ssid", "bh0_auth", "bh0_enc", "bh0_key", "bh0_raid" }) do
				local v = tostring(args[opt] or "")
				if v ~= "" then
					if v:find("[%z\1-\31\127\"'\\`$]") or #v > 128 then
						print(json.stringify({ ok = false, error = "Invalid value for " .. opt }))
						return
					end
					vals[opt] = v
				end
			end

			local cursor = uci.cursor()
			for opt, v in pairs(vals) do
				cursor:set("easymesh", "config", opt, v)
			end
			-- activating a backhaul profile requires the valid flag
			if vals.bh0_ssid or vals.bh0_auth or vals.bh0_enc or vals.bh0_key or vals.bh0_raid then
				cursor:set("easymesh", "config", "bh0_valid", "1")
			end
			cursor:commit("easymesh")

			local enabled, bandsteering, mesh_sr, steeringthresold = push_config(cursor)
			sync_wireless(cursor, enabled, bandsteering, mesh_sr, steeringthresold)
			local started, via = restart_daemons(enabled)

			print(json.stringify({
				ok = true,
				enabled = enabled,
				restarted = (enabled == "1") and started or false,
				started_via = (enabled == "1") and via or nil
			}))
		end
	},

	resetDefault = {
		call = function()
			kv_set_1(MAPD_CFG, "DeviceRole", "1")
			kv_set_1(MAPD_CFG, "mode", "1")

			local per_file = {}
			for _, e in ipairs(MAP_SCHEMA) do
				per_file[e.f] = per_file[e.f] or {}
				per_file[e.f][e.k] = e.d
			end
			for file, upd in pairs(per_file) do
				kv_set(file, upd)
			end

			kv_set(MAP1905, { map_root = "1", map_agent = "1" })

			local al = br_mac()
			if al ~= "" then
				kv_set(MAP1905, { map_controller_alid = al, map_agent_alid = al })
			end

			local cursor = uci.cursor()
			cursor:set("easymesh", "config", "enabled", "0")
			cursor:set("easymesh", "config", "device_mode", "router")
			cursor:set("easymesh", "config", "device_role", "controller")
			cursor:set("easymesh", "config", "mesh_sr", "1")
			cursor:set("easymesh", "config", "bandsteering", "1")
			cursor:set("easymesh", "config", "steeringthresold", "-65")
			for _, e in ipairs(MAP_SCHEMA) do
				cursor:set("easymesh", "config", e.u, e.d)
			end
			cursor:commit("easymesh")

			-- stop wapp for good, including across hotplug events
			sync_wireless(cursor, "0", "0", "0", "-65")
			restart_daemons("0")

			print(json.stringify({ ok = true }))
		end
	},

	pbcTrigger = {
		args = { iface = "" },
		call = function(_args)
			local args = norm(_args)
			local iface = v_iface(args and args.iface)
			if not iface then
				print(json.stringify({ ok = false, error = "Invalid interface name" }))
				return
			end
			local out = wappctrl(iface, "wps_pbc_trigger")
			print(json.stringify({ ok = true, output = out }))
		end
	},

	wappReload = {
		args = { iface = "" },
		call = function(_args)
			local args = norm(_args)
			local iface = v_iface(args and args.iface)
			if not iface then
				print(json.stringify({ ok = false, error = "Invalid interface name" }))
				return
			end
			local out = wappctrl(iface, "reload")
			print(json.stringify({ ok = true, output = out }))
		end
	},

	wappVersion = {
		args = { iface = "" },
		call = function(_args)
			local args = norm(_args)
			local iface = v_iface(args and args.iface)
			if not iface then
				print(json.stringify({ ok = false, error = "Invalid interface name" }))
				return
			end
			print(json.stringify({
				ok = true,
				version = wappctrl(iface, "version"),
				hs_version = wappctrl(iface, "hs_version"),
				drv_version = wappctrl(iface, "drv_version")
			}))
		end
	},

	steerSta = {
		args = { iface = "", mac = "" },
		call = function(_args)
			local args = norm(_args)
			local iface = v_iface(args and args.iface)
			local mac = v_mac(args and args.mac)
			if not iface or not mac then
				print(json.stringify({ ok = false, error = "Invalid interface or MAC address" }))
				return
			end
			local out = wappctrl(iface, "mbo steer_sta " .. mac)
			print(json.stringify({ ok = true, output = out }))
		end
	},

	btmReq = {
		args = { mac = "", ess_imm = "0", timer = "0", url = "" },
		call = function(_args)
			local args = norm(_args)
			local mac = v_mac(args and args.mac)
			local ess = (args and args.ess_imm == "1") and "1" or "0"
			local timer = v_uint(args and args.timer) or "0"
			local url = (args and args.url ~= "") and v_text(args.url) or nil
			if not mac or (args and args.url ~= "" and not url) then
				print(json.stringify({ ok = false, error = "Invalid arguments" }))
				return
			end
			local cmd = "btmreq " .. mac .. " " .. ess .. " " .. timer
			if url then cmd = cmd .. " '" .. url .. "'" end
			local out = wappctrl("ra0", cmd)
			print(json.stringify({ ok = true, output = out }))
		end
	},

	dppQrCode = {
		args = { uri = "" },
		call = function(_args)
			local args = norm(_args)
			local uri = v_text(args and args.uri)
			if not uri then
				print(json.stringify({ ok = false, error = "Invalid DPP URI" }))
				return
			end
			local out = wappctrl("ra0", "dpp dpp_qr_code '" .. uri .. "'")
			local cursor = uci.cursor()
			cursor:set("easymesh", "config", "dpp_uri", uri)
			cursor:commit("easymesh")
			print(json.stringify({ ok = true, output = out }))
		end
	},

	dppBootstrapGetUri = {
		args = { id = "0" },
		call = function(_args)
			local args = norm(_args)
			local id = v_uint(args and args.id)
			if not id then
				print(json.stringify({ ok = false, error = "Invalid bootstrap id" }))
				return
			end
