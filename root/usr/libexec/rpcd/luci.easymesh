			local out = wappctrl("ra0", "map set_bh_type " .. t)
			kv_set_1(MAP1905, "bh_type", t)
			local cursor = uci.cursor()
			cursor:set("easymesh", "config", "bh_type", t)
			cursor:commit("easymesh")
			print(json.stringify({ ok = true, output = out }))
		end
	},

	wnmReq = {
		args = { iface = "", mac = "", url = "" },
		call = function(_args)
			local args = norm(_args)
			local iface = v_iface(args and args.iface)
			local mac = v_mac(args and args.mac)
			local url = (args and args.url ~= "") and v_text(args.url) or nil
			if not iface or not mac or (args and args.url ~= "" and not url) then
				print(json.stringify({ ok = false, error = "Invalid arguments" }))
				return
			end
			local cmd = "wnmreq " .. mac
			if url then cmd = cmd .. " '" .. url .. "'" end
			local out = wappctrl(iface, cmd)
			print(json.stringify({ ok = true, output = out }))
		end
	},

	wnmReq2 = {
		args = { iface = "", mac = "", code = "1", delay = "0", url = "" },
		call = function(_args)
			local args = norm(_args)
			local iface = v_iface(args and args.iface)
			local mac = v_mac(args and args.mac)
			local code = v_uint(args and args.code)
			local delay = v_uint(args and args.delay)
			local url = (args and args.url ~= "") and v_text(args.url) or nil
			if not iface or not mac or not code or not delay
			   or (args and args.url ~= "" and not url) then
				print(json.stringify({ ok = false, error = "Invalid arguments" }))
				return
			end
			local cmd = "wnmreq2 " .. mac .. " " .. code .. " " .. delay
			if url then cmd = cmd .. " '" .. url .. "'" end
			local out = wappctrl(iface, cmd)
			print(json.stringify({ ok = true, output = out }))
		end
	},

	qosMap = {
		args = { iface = "", mac = "", dscp_exception = "", dscp_range = "" },
		call = function(_args)
			local args = norm(_args)
			local iface = v_iface(args and args.iface)
			local mac = v_mac(args and args.mac)
			if not iface or not mac then
				print(json.stringify({ ok = false, error = "Invalid arguments" }))
				return
			end
			local cmd = "qosmap " .. mac
			local exc = (args and args.dscp_exception ~= "") and v_uint(args.dscp_exception) or nil
			local rng = (args and args.dscp_range ~= "") and v_text(args.dscp_range) or nil
			if exc then cmd = cmd .. " " .. exc end
			if rng then cmd = cmd .. " '" .. rng .. "'" end
			local out = wappctrl(iface, cmd)
			print(json.stringify({ ok = true, output = out }))
		end
	},

	proxyArpList = {
		args = { family = "ipv4" },
		call = function(_args)
			local args = norm(_args)
			local cmd = (args and args.family == "ipv6") and "ipv6_proxy_arp_list" or "ipv4_proxy_arp_list"
			local out = wappctrl("ra0", cmd)
			print(json.stringify({ ok = true, output = out }))
		end
	}
}

-- ---------------------------------------------------------------------------
-- rpcd protocol glue
-- ---------------------------------------------------------------------------

local function parseInput()
	local parse = json.new()
	local done, err
	while true do
		local chunk = io.read(4096)
		if not chunk then break
		elseif not done and not err then
			done, err = parse:parse(chunk)
		end
	end
	if not done then
		print(json.stringify({ error = err or "Incomplete input" }))
		os.exit(1)
	end
	return parse:get()
end

local function validateArgs(func, uargs)
	local method = methods[func]
	if not method then
		print(json.stringify({ error = "Method not found" }))
		os.exit(1)
	end
	if type(uargs) ~= "table" then
		print(json.stringify({ error = "Invalid arguments" }))
		os.exit(1)
	end
	uargs.ubus_rpc_session = nil
	local margs = method.args or {}
	for k, v in pairs(uargs) do
		if margs[k] == nil or (v ~= nil and type(v) ~= type(margs[k])) then
			print(json.stringify({ error = "Invalid arguments" }))
			os.exit(1)
		end
	end
	return method
end

if arg[1] == "list" then
	local rv = {}
	for name, method in pairs(methods) do
		rv[name] = method.args or {}
	end
	print((json.stringify(rv):gsub(":%[%]", ":{}")))
elseif arg[1] == "call" then
	local args = parseInput()
	local method = validateArgs(arg[2], args)
	local result, code = method.call(args)
	print((json.stringify(result):gsub("^%[%]$", "{}")))
	os.exit(code or 0)
end
