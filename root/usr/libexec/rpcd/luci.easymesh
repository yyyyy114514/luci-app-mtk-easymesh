			local args = norm(_args)
			local cmd = "dpp dpp_bootstrap_gen type=qrcode"
			local opts = {}
			if args and args.chan ~= "" then table.insert(opts, "chan=" .. args.chan) end
			if args and args.mac ~= "" then table.insert(opts, "mac=" .. args.mac) end
			if args and args.info ~= "" then table.insert(opts, "info=" .. args.info) end
			if args and args.curve ~= "" then table.insert(opts, "curve=" .. args.curve) end
			if args and args.key ~= "" then table.insert(opts, "key=" .. args.key) end
			if #opts > 0 then cmd = cmd .. " " .. table.concat(opts, " ") end
			local out = wappctrl("ra0", cmd)
			print(json.stringify({ ok = true, output = out }))
		end
